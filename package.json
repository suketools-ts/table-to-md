{
  "name": "table-to-md",
  "private": true,
  "version": "0.0.0",
  "author": "tera",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "build:artifact": "npm run build && node scripts/make-artifact-page.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:fixtures": "node scripts/build-fixtures.mjs",
    "test:extension": "npm run build:extension && npm run build:fixtures && node extension-test/verify.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-masume-grid": "^0.8.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.55.1",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
